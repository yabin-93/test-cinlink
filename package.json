{
  "name": "deepseek-cinlink-tests",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek × CinLink Web 独立自动化测试工程（迁移自 test-cinlink-web）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test --project=unit --project=gates",
    "test:all": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:gates": "playwright test --project=gates",
    "test:staging": "playwright test --project=staging",
    "test:g1": "playwright test --project=staging g1-upload",
    "test:g2": "playwright test --project=staging g2-submit",
    "test:g3": "playwright test --project=staging g3-g7-subtitle",
    "test:watermark": "playwright test --project=staging g3-g7-image-watermark",
    "test:flows": "playwright test --project=staging g3-g7-workflows",
    "test:cards": "playwright test --project=staging g3-g7-cards",
    "test:smoke": "playwright test --project=staging --grep @smoke",
    "test:regression": "playwright test --project=staging --grep @regression",
    "test:full": "playwright test --project=staging",
    "test:quick": "playwright test --project=staging g3-g7-quick-cards",
    "test:multi": "playwright test --project=staging g3-g7-multi",
    "test:chains": "playwright test --project=staging g3-g7-chains",
    "test:ai": "playwright test --project=staging g3-g7-cards",
    "test:annotation": "playwright test --project=annotation",
    "test:annotation:staging": "playwright test --project=annotation-staging",
    "auth:profile": "playwright test --project=annotation-login",
    "auth": "playwright test --project=auth",
    "doctor": "playwright test --project=doctor",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test",
    "report": "playwright show-report reports/html",
    "region:diff": "python tools/annotation/region_diff.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.2"
  }
}
