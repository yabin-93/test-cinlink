# 复制为 local.env 后填写（推荐用不带点的名字，Windows 上双击即可编辑）。
#
#   Copy-Item .env.local.example local.env
#   notepad local.env
#
# local.env / .env.local 都已被 .gitignore 忽略，不会提交。
# 不要把这些值写进 README、代码、或任何会提交的文件里。
# 注意：本模板文件（.env.local.example）**是要提交的**，不要在这里填真实凭据。

# ---------------------------------------------------------------------------
# 靶场地址（两条线分开，别合并成一个变量）
# ---------------------------------------------------------------------------
# 被测前端：预发（端到端 / 契约用例用）
CINLINK_BASE_URL=https://staging-app.cinlink.ai
CINLINK_STUDIO_BASE=https://staging-app.cinlink.ai
CINLINK_RUNTIME_BASE=https://staging-runtime.cinlink.ai

# 本地 preview 靶场（editor / probe 用例用）。
# 一般不需要改——留空即用下面的默认值。改成本地地址也可以：
#   CINLINK_LOCAL_BASE_URL=http://127.0.0.1:4173
CINLINK_LOCAL_BASE_URL=http://127.0.0.1:4173

# ---------------------------------------------------------------------------
# 测试账号凭据（二选一即可，两个都填则 API Key 优先）
# ---------------------------------------------------------------------------
CINLINK_TEST_EMAIL=
CINLINK_TEST_PASSWORD=
CINLINK_TEST_API_KEY=

# ---------------------------------------------------------------------------
# 浏览器会话（推荐方式，避免每次跑测试都重新登录）
# ---------------------------------------------------------------------------
# 手动登录一次后导出的 storageState 绝对路径；留空则用 .auth/storage-state.json
CINLINK_TEST_STORAGE_STATE=

# ---------------------------------------------------------------------------
# 可选
# ---------------------------------------------------------------------------
# 改用 Playwright 自带浏览器时留空即可
CINLINK_BROWSER_CHANNEL=chrome
CINLINK_FFPROBE=ffprobe
